<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Borrar Estudiante</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Borrar Estudiante</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/student/delete" method="post" class="space-y-4"
              onsubmit="return confirm('¿Estás seguro de que deseas eliminar este estudiante y su usuario?')">
            
            <div>
                <label for="id" class="block text-gray-700 text-sm font-medium mb-1">Nombre de la carrera:</label>
                <select id="id" name="identificador_carrera" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    {{#careers}}
                    <option value="{{id}}">{{name}}</option>
                    {{/careers}}
                </select>
            </div>

            <button type="submit" class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                Eliminar Carrera
            </button>
            
            <div class="text-center mt-4">
                <button type="button" 
                        onclick="history.back()"
                        class="text-red-600 hover:underline text-sm">
                    Cancelar
                </button>
            </div>
        </form>
    </div>
</body>
</html>