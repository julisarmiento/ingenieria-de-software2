<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Borrar Plan de Estudio</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">

    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-lg">
        
        <h2 class="text-3xl font-bold text-center text-red-700 mb-6">Eliminar Plan de Estudio</h2>

        {{#successMessage}}
            <div class="mb-4 p-4 bg-green-100 text-green-800 border border-green-300 rounded">
                {{successMessage}}
            </div>
        {{/successMessage}}

        {{#errorMessage}}
            <div class="mb-4 p-4 bg-red-100 text-red-800 border border-red-300 rounded">
                {{errorMessage}}
            </div>
        {{/errorMessage}}

        <p class="text-gray-600 mb-6 text-center">Seleccioná el plan de estudio que querés dar de baja. <br> <span class="font-bold text-red-600">¡Esta acción no se puede deshacer!</span></p>

        <form action="/program-of-study/delete" method="POST" class="space-y-6">
            
            <div>
                <label class="block text-gray-700 font-semibold mb-2">Seleccionar Plan:</label>
                <select name="plan_id" required 
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-red-500 bg-white">
                    <option value="" disabled selected>-- Elegí un plan de estudio --</option>
                    <!-- Recorremos la lista de planes que nos mandó el controlador -->
                    {{#planes}}
                        <option value="{{id}}">{{career_name}} (Plan ID: {{id}} - Año: {{year_version}} - {{status}})</option>
                    {{/planes}}
                </select>
            </div>

            <div class="pt-4 flex justify-between">
                <button type="button"
                        onclick="window.location.href='/dashboard'"
                        class="text-gray-600 hover:underline text-sm">
                    Volver al inicio
                </button>
                <button type="submit" class="inline-block bg-red-600 text-white py-2 px-6 rounded-md hover:bg-red-700 transition duration-300 font-bold"
                        onclick="return confirm('¿Estás seguro de que querés eliminar este plan de estudio definitivamente?');">
                    Eliminar
                </button>
            </div>
            
        </form>
    </div>

</body>
</html>