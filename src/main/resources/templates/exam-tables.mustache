<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mis Mesas de Examen</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-8">
    <div class="max-w-4xl mx-auto">
        <div class="flex items-center justify-between mb-6">
            <h1 class="text-3xl font-bold text-gray-800">Mis Mesas de Examen</h1>
            <button onclick="window.location.href='/professor/exam-tables/new'"
                    class="bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700">
                + Nueva Mesa
            </button>
        </div>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            <span>{{successMessage}}</span>
        </div>
        {{/successMessage}}
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            <span>{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        {{#examTables}}
        <div class="bg-white rounded-lg shadow mb-4 p-6">
            <div class="flex items-start justify-between">
                <div>
                    <h2 class="text-xl font-semibold text-gray-800">{{subjectName}}</h2>
                    <p class="text-gray-500 text-sm mt-1">{{careerName}}</p>
                    <p class="text-gray-600 mt-2">📅 {{examDate}}</p>
                    {{#location}}
                    <p class="text-gray-600">📍 {{location}}</p>
                    {{/location}}
                </div>
                <div class="flex flex-col items-end gap-2">
                    <!-- Badge de estado -->
                    {{#isOpen}}
                    <span class="bg-green-100 text-green-700 text-xs font-medium px-3 py-1 rounded-full">ABIERTA</span>
                    {{/isOpen}}
                    {{#isClosed}}
                    <span class="bg-gray-100 text-gray-600 text-xs font-medium px-3 py-1 rounded-full">CERRADA</span>
                    {{/isClosed}}
                    {{#isCancelled}}
                    <span class="bg-red-100 text-red-600 text-xs font-medium px-3 py-1 rounded-full">CANCELADA</span>
                    {{/isCancelled}}

                    <!-- Acciones -->
                    {{#isOpen}}
                    <div class="flex gap-2 mt-2">
                        <button onclick="window.location.href='/professor/exam-tables/{{id}}/enrollments'"
                                class="bg-blue-600 text-white text-sm py-1 px-3 rounded hover:bg-blue-700">
                            Ver inscriptos
                        </button>
                        <form action="/professor/exam-tables/{{id}}/close" method="post">
                            <button type="submit"
                                    class="bg-yellow-500 text-white text-sm py-1 px-3 rounded hover:bg-yellow-600">
                                Cerrar
                            </button>
                        </form>
                        <form action="/professor/exam-tables/{{id}}/cancel" method="post">
                            <button type="submit"
                                    onclick="return confirm('¿Seguro que querés cancelar esta mesa?')"
                                    class="bg-red-500 text-white text-sm py-1 px-3 rounded hover:bg-red-600">
                                Cancelar
                            </button>
                        </form>
                    </div>
                    {{/isOpen}}
                    {{#isClosed}}
                    <button onclick="window.location.href='/professor/exam-tables/{{id}}/enrollments'"
                            class="bg-blue-600 text-white text-sm py-1 px-3 rounded hover:bg-blue-700 mt-2">
                        Ver inscriptos
                    </button>
                    {{/isClosed}}
                </div>
            </div>
        </div>
        {{/examTables}}

        {{^examTables}}
        <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
            No tenés mesas de examen creadas todavía.
        </div>
        {{/examTables}}

        <div class="text-center mt-6">
            <button onclick="window.location.href='/dashboard'"
                    class="text-red-600 hover:underline text-sm">
                Volver al inicio
            </button>
        </div>
    </div>
</body>
</html>