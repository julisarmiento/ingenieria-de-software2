<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Materias Aprobadas</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-slate-50 p-8">
    <div class="max-w-4xl mx-auto">
        <div class="mb-8">
            <h1 class="text-3xl font-extrabold text-slate-800">Materias Aprobadas</h1>
            <p class="text-slate-500">Historial académico de materias aprobadas</p>
        </div>

        <div class="bg-white rounded-2xl shadow-sm border border-slate-200 overflow-hidden">
            <table class="w-full text-left">
                <thead class="bg-slate-100/50">
                    <tr>
                        <th class="p-4 text-slate-600 font-semibold">Materia</th>
                        <th class="p-4 text-slate-600 font-semibold text-center">Nota</th>
                        <th class="p-4 text-slate-600 font-semibold text-center">Estado</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-slate-100">
                    {{#materiasAprobadas}}
                    <tr class="hover:bg-slate-50 transition-colors">
                        <td class="p-4 font-medium text-slate-800">{{nombre_materia}}</td>
                        <td class="p-4 font-mono text-center font-bold text-slate-700">{{nota}}</td>
                        <td class="p-4 text-center">
                            <span class="px-3 py-1 bg-blue-100 text-blue-700 rounded-full text-xs font-bold uppercase tracking-wide">Aprobado</span>
                        </td>
                    </tr>
                    {{/materiasAprobadas}}
                    {{^materiasAprobadas}}
                    <tr>
                        <td colspan="3" class="p-12 text-center text-slate-400 italic">No tienes materias aprobadas aún.</td>
                    </tr>
                    {{/materiasAprobadas}}
                </tbody>
            </table>
        </div>

        <div class="mt-8">
            <a href="/profile" class="inline-flex items-center text-slate-500 hover:text-blue-600 font-medium transition-colors">
                <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
                Volver al Perfil
            </a>
        </div>
    </div>
</body>
</html>