<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alta Plan de Estudio</title>
    <!-- Importo Tailwind CSS igual que en el dashboard -->
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">

    <!-- Contenedor principal centrado tipo tarjeta -->
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-lg">
        
        <h2 class="text-3xl font-bold text-center text-gray-800 mb-6">Crear Nuevo Plan de Estudio</h2>

        <!-- Mensaje de error estilizado -->
        {{#errorMessage}}
            <div class="mb-4 p-4 bg-red-100 text-red-800 border border-red-300 rounded">
                {{errorMessage}}
            </div>
        {{/errorMessage}}

        <form action="/plan-estudio/create" method="POST" class="space-y-4">
            
            <div>
                <label class="block text-gray-700 font-semibold mb-2">Nombre de la Materia:</label>
                <input type="text" name="subjectName" required 
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-gray-700 font-semibold mb-2">Tipo de Materia:</label>
                <select name="subjectType" required 
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                    <option value="Required">Obligatoria</option>
                    <option value="Elective">Electiva</option>
                </select>
            </div>

            <!-- Grilla para poner Año y Horas uno al lado del otro -->
            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">Año:</label>
                    <input type="number" name="year" required 
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-gray-700 font-semibold mb-2">Horas:</label>
                    <input type="number" name="hours" 
                           class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>

            <div>
                <label class="block text-gray-700 font-semibold mb-2">Requisitos de Cursada:</label>
                <input type="text" name="curseReq" 
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-gray-700 font-semibold mb-2">Requisitos de Examen:</label>
                <input type="text" name="examReq" 
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div>
                <label class="block text-gray-700 font-semibold mb-2">ID de Facultad:</label>
                <input type="number" name="faculty_id" required 
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <!-- Botones de acción -->
            <div class="pt-6 flex justify-between">
                <a href="/dashboard" class="inline-block bg-gray-500 text-white py-2 px-6 rounded-md hover:bg-gray-600 transition duration-300">
                    Volver
                </a>
                <button type="submit" class="inline-block bg-blue-600 text-white py-2 px-6 rounded-md hover:bg-blue-700 transition duration-300 font-bold">
                    Guardar Plan
                </button>
            </div>
            
        </form>
    </div>

</body>
</html>