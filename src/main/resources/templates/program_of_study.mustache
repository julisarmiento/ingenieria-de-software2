<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Alta Plan de Estudio</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">

    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-lg">
        
        <h2 class="text-3xl font-bold text-center text-gray-800 mb-6">Crear Nuevo Plan de Estudio</h2>

        {{#errorMessage}}
            <div class="mb-4 p-4 bg-red-100 text-red-800 border border-red-300 rounded">
                {{errorMessage}}
            </div>
        {{/errorMessage}}

        <form action="/program-of-study/create" method="POST" class="space-y-4">
            
            <div>
                <label class="block text-gray-700 font-semibold mb-2">Carrera:</label>
                <select name="career_id" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500 bg-white">
                    <option value="" disabled selected>-- Seleccione la Carrera --</option>
                    {{#careers}}
                    <option value="{{id}}">{{name}}</option>
                    {{/careers}}
                </select>
            </div>

            <div class="grid grid-cols-3 gap-4">
            <div>
                    <label class="block text-gray-700 font-semibold mb-2 text-xs">Año de Versión:</label>
                    <input type="number" name="year_version" placeholder="2026" required 
                            class="w-full px-3 py-2 border border-gray-300 rounded-md">
            </div>
                <div>
                    <label class="block text-gray-700 font-semibold mb-2 text-xs">Obligatorias:</label>
                    <input type="number" name="mandatory_subjects" placeholder="Oblig." required 
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
                <div>
                    <label class="block text-gray-700 font-semibold mb-2 text-xs">Optatativas:</label>
                    <input type="number" name="elective_subjects" placeholder="Optat." required 
                           class="w-full px-3 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                </div>
            </div>

            <div class="pt-6 flex justify-between items-center">
                <button type="button"
                        onclick="window.location.href='/dashboard'"
                        class="text-gray-600 hover:underline text-sm">
                    Volver al inicio
                </button>
                <button type="submit" class="bg-blue-600 text-white py-2 px-6 rounded-md hover:bg-blue-700 transition duration-300 font-bold">
                    Siguiente: Cargar Materias
                </button>
            </div>
            
        </form>
    </div>

</body>
</html>