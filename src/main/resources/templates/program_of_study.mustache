<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Plan de Estudio - Sistema Académico</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        mainbg: '#dcd8d1',
                        cardpanel: '#cecbc2',
                        cardbg: '#ebe8e1',
                        uniblue: '#3b5a82',
                        unired: '#932c35'
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-mainbg flex items-center justify-center min-h-screen p-4 font-sans">

    <div class="bg-cardpanel p-6 sm:p-8 rounded-2xl shadow-2xl w-full max-w-lg border border-gray-300/50">
        
        <div class="bg-cardbg p-8 rounded-xl shadow-sm border border-white/50">
            
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-12 h-12 bg-white rounded-full mb-4 shadow-sm text-2xl">
                    📄
                </div>
                <h1 class="text-2xl font-extrabold text-gray-800 tracking-tight">Crear Nuevo Plan</h1>
                <p class="text-gray-600 mt-2 text-sm">Registra una nueva currícula para una carrera</p>
            </div>

            {{#errorMessage}}
            <div class="bg-red-100 border-l-4 border-red-500 text-red-800 px-4 py-3 rounded mb-6 shadow-sm" role="alert">
                <span class="block sm:inline font-medium text-sm">{{errorMessage}}</span>
            </div>
            {{/errorMessage}}

            <form action="/program-of-study/create" method="POST" class="space-y-6">
                
                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-2">Carrera</label>
                    <select name="career_id" required 
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner cursor-pointer">
                        <option value="" disabled selected>-- Seleccione la Carrera --</option>
                        {{#careers}}
                        <option value="{{id}}">{{name}}</option>
                        {{/careers}}
                    </select>
                </div>

                <div class="grid grid-cols-3 gap-4">
                    <div>
                        <label class="block text-gray-700 text-xs font-bold mb-2">Año de Versión</label>
                        <input type="number" name="year_version" placeholder="2026" required min="1"
                               class="w-full px-3 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400 text-sm">
                    </div>
                    <div>
                        <label class="block text-gray-700 text-xs font-bold mb-2">Obligatorias</label>
                        <input type="number" name="mandatory_subjects" placeholder="Oblig." required min="1"
                               class="w-full px-3 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400 text-sm">
                    </div>
                    <div>
                        <label class="block text-gray-700 text-xs font-bold mb-2">Optativas</label>
                        <input type="number" name="elective_subjects" placeholder="Optat." required min="0"
                               class="w-full px-3 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400 text-sm">
                    </div>
                </div>

                <button type="submit" 
                        class="w-full bg-uniblue text-white font-bold py-3 px-4 rounded-xl shadow-md hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-uniblue focus:ring-offset-2 focus:ring-offset-cardbg transition-all duration-200 transform hover:-translate-y-0.5">
                    Siguiente: Cargar Materias
                </button>

                <div class="text-center mt-6 pt-5 border-t border-gray-400/30">
                    <button type="button"
                            onclick="window.location.href='/dashboard'"
                            class="text-gray-600 hover:text-gray-900 font-semibold text-sm flex items-center justify-center gap-2 w-full transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                        Volver al Panel
                    </button>
                </div>
                
            </form>
        </div>
    </div>

</body>
</html>