<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mi Perfil - Sistema Académico</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-8 font-sans">
    <div class="max-w-4xl mx-auto bg-white p-8 rounded-lg shadow-lg">
        
        <h1 class="text-3xl font-bold text-gray-800 mb-6 border-b pb-2">Mi Perfil</h1>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            
            <div class="{{#isStudent}}md:col-span-2{{/isStudent}}{{^isStudent}}md:col-span-3{{/isStudent}}">
                <h2 class="text-xl font-semibold text-blue-700 mb-4">Datos Personales</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-gray-700 bg-blue-50 p-6 rounded-md border border-blue-100 shadow-sm">
                    <p><strong>Nombre:</strong> {{nombre}}</p>
                    <p><strong>Apellido:</strong> {{apellido}}</p>
                    <p><strong>DNI:</strong> {{dni}}</p>
                    <p><strong>Correo:</strong> {{correo}}</p>
                    
                    {{#edad}}<p><strong>Edad:</strong> {{edad}}</p>{{/edad}}
                    {{#telefono}}<p><strong>Teléfono:</strong> {{telefono}}</p>{{/telefono}}
                </div>

                {{#isStudent}}
                <div class="mt-8">
                    <h2 class="text-xl font-semibold text-blue-700 mb-4">Mis Carreras</h2>
                    <div class="bg-blue-50/40 p-4 rounded-md border border-blue-100 shadow-inner">
                        
                        {{#carreras}}
                        <div class="flex items-center mb-2 last:mb-0 bg-white px-4 py-3 rounded-lg shadow-sm border border-gray-200 transition hover:shadow-md">
                            <div class="w-2 h-2 bg-blue-600 rounded-full mr-3 shrink-0"></div>
                            <p class="font-bold text-gray-800">{{name}}</p>
                        </div>
                        {{/carreras}}
                        
                        {{^carreras}}
                        <p class="text-gray-500 italic text-center py-4">Todavía no estás inscripto en ninguna carrera.</p>
                        {{/carreras}}
                        
                    </div>
                </div>
                {{/isStudent}}
                </div>

            {{#isStudent}}
            <div class="md:col-span-1 flex flex-col pt-12 space-y-4">
                <a href="/student/cursando" class="block text-center bg-blue-600 text-white font-semibold py-3 px-4 rounded-md hover:bg-blue-700 shadow-sm transition">
                    Materias Cursadas
                </a>

                <a href="/student/approved" class="block text-center bg-blue-600 text-white font-semibold py-3 px-4 rounded-md hover:bg-blue-700 shadow-sm transition">
                    Materias Aprobadas
                </a>
            </div>
            {{/isStudent}}
            
        </div>
        
        <div class="mt-10 border-t pt-4">
            <a href="/dashboard" class="text-blue-600 hover:text-blue-800 hover:underline font-bold transition">&larr; Volver al Panel</a>
        </div>

    </div>
</body>
</html>