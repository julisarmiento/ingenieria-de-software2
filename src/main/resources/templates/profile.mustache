<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Mi Perfil</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-8">
    <div class="max-w-4xl mx-auto bg-white p-8 rounded-lg shadow-lg">
        
        <h1 class="text-3xl font-bold text-gray-800 mb-6 border-b pb-2">Mi Perfil</h1>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            
            <div class="md:col-span-2">
                <h2 class="text-xl font-semibold text-blue-700 mb-4">Datos Personales</h2>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-gray-700 bg-blue-50 p-6 rounded-md border border-blue-100">
                    <p><strong>Nombre:</strong> {{nombre}}</p>
                    <p><strong>Apellido:</strong> {{apellido}}</p>
                    <p><strong>DNI:</strong> {{dni}}</p>
                    <p><strong>Edad:</strong> {{edad}}</p>
                    <p><strong>Correo:</strong> {{correo}}</p>
                    <p><strong>Teléfono:</strong> {{telefono}}</p>
                </div>
            </div>

            <div class="md:col-span-1 flex flex-col justify-center space-y-4">
                
                <a href="#" class="block text-center bg-gray-100 text-gray-700 font-semibold py-3 px-4 rounded-md border border-gray-300 hover:bg-gray-200">
                    Materias Cursadas
                </a>

                <a href="#" class="block text-center bg-gray-100 text-gray-700 font-semibold py-3 px-4 rounded-md border border-gray-300 hover:bg-gray-200">
                    Materias Rendidas
                </a>
                
            </div>
            
        </div>
        
        <div class="mt-10 border-t pt-4">
            <a href="/dashboard" class="text-blue-600 hover:underline font-bold">&larr; Volver al Panel</a>
        </div>

    </div>
</body>
</html>