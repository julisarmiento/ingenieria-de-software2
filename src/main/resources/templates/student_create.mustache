<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Registrar Estudiante</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Registrar Estudiante</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/student/create" method="post" class="space-y-4"
            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-gray-700 text-sm font-medium mb-1">Usuario:</label>
                    <input type="text" name="username" required class="w-full px-4 py-2 border border-gray-300 rounded-md">
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-medium mb-1">Contraseña:</label>
                    <input type="password" name="password" required class="w-full px-4 py-2 border border-gray-300 rounded-md">
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                <div>
                    <label class="block text-gray-700 text-sm font-medium mb-1">Nombre:</label>
                    <input type="text" name="name" required class="w-full px-4 py-2 border border-gray-300 rounded-md">
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-medium mb-1">Apellido:</label>
                    <input type="text" name="surname" required class="w-full px-4 py-2 border border-gray-300 rounded-md">
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-medium mb-1">DNI:</label>
                    <input type="text" name="dni" required class="w-full px-4 py-2 border border-gray-300 rounded-md">
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-medium mb-1">Correo:</label>
                    <input type="email" name="mail" required class="w-full px-4 py-2 border border-gray-300 rounded-md">
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-medium mb-1">Edad:</label>
                    <input type="number" name="age" required min="16" class="w-full px-4 py-2 border border-gray-300 rounded-md">
                </div>
                <div>
                    <label class="block text-gray-700 text-sm font-medium mb-1">Teléfono:</label>
                    <input type="text" name="phoneNum" required class="w-full px-4 py-2 border border-gray-300 rounded-md">
                </div>
            </div>
            
            <div class="mt-2 flex items-center">
                <input type="checkbox" id="isFreshman" name="isFreshman" class="h-4 w-4 text-blue-600 rounded">
                <label for="isFreshman" class="ml-2 block text-sm text-gray-900 font-medium">¿Es ingresante?</label>
            </div>

            <button type="submit" class="w-full bg-blue-600 text-white py-2 px-4 rounded-md hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-blue-500 focus:ring-offset-2">
                Registrar Estudiante
            </button>
            
            <div class="text-center mt-4">
                <button type="button" 
                        onclick="window.location.hreff='/dashboard'"
                        class="text-red-600 hover:underline text-sm">
                    Cancelar
                </button>
            </div>
        </form>
    </div>
</body>
</html>