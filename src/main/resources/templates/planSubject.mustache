<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Cargar Materia al Plan</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-4">
    <div class="max-w-2xl mx-auto bg-white p-8 rounded-lg shadow-lg">
        <h2 class="text-2xl font-bold mb-6">Paso 1: Agregar Materia al Plan</h2>

        {{#errorMessage}}
            <div class="mb-4 p-4 bg-red-100 text-red-800 border border-red-300 rounded">
                {{errorMessage}}
            </div>
        {{/errorMessage}}
        {{#message}}
            <div class="mb-4 p-4 bg-green-100 text-green-800 border border-green-300 rounded">
                {{message}}
            </div>
        {{/message}}

        <form action="/plan-subject/create" method="POST" class="space-y-4">
            <input type="hidden" name="program_id" value="{{program_id}}">

            <div>
                <label class="block font-semibold">Materia:</label>
                <select name="subject_id" required class="w-full border p-2 rounded">
                    {{#subjects}}
                    <option value="{{id}}">{{name}}</option>
                    {{/subjects}}
                </select>
            </div>

            <div class="grid grid-cols-2 gap-4">
                <input type="number" name="year" placeholder="Año" required class="border p-2 rounded">
                <input type="number" name="hours" placeholder="Horas" required class="border p-2 rounded">
            </div>

            <div>
                {{#hasElectives}}
                <label class="flex items-center space-x-2">
                    <input type="checkbox" name="is_elective" class="w-5 h-5">
                    <span>¿Es Optativa?</span>
                </label>
                {{/hasElectives}}
                {{^hasElectives}}
                <label class="flex items-center space-x-2 text-gray-400">
                    <input type="checkbox" name="is_elective" class="w-5 h-5" disabled>
                    <span>Todas las materias son obligatorias en este plan</span>
                </label>
                {{/hasElectives}}
            </div>

            <div class="mt-4 flex justify-center">
                <a href="/program-of-study/cancel?id={{program_id}}" 
                   onclick="return confirm('¿Seguro que querés cancelar? Se borrará el plan incompleto y perderás todo el progreso.');"
                   class="text-red-500 hover:underline text-sm font-semibold">
                   Cancelar carga y descartar plan
                </a>
            </div>
            <button type="submit" class="w-full bg-blue-600 text-white py-2 rounded font-bold hover:bg-blue-700">
                Siguiente: Asignar Correlativas ->
            </button>
        </form>
    </div>
</body>
</html>