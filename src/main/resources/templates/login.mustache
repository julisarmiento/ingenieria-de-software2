<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Iniciar Sesión - Sistema Académico</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        mainbg: '#dcd8d1',
                        cardpanel: '#cecbc2',
                        cardbg: '#ebe8e1',
                        uniblue: '#3b5a82',
                        unired: '#932c35'
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-mainbg flex items-center justify-center min-h-screen p-4 font-sans">
    
    <div class="bg-cardpanel p-6 sm:p-8 rounded-2xl shadow-2xl w-full max-w-md border border-gray-300/50">
        
        <div class="bg-cardbg p-8 rounded-xl shadow-sm border border-white/50">
            
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-12 h-12 bg-white rounded-full mb-4 shadow-sm text-2xl">
                    🔐
                </div>
                <h1 class="text-2xl font-extrabold text-gray-800 tracking-tight">Iniciar Sesión</h1>
                <p class="text-gray-600 mt-2 text-sm">Ingresá tus credenciales para acceder</p>
            </div>

            {{#successMessage}}
            <div class="bg-green-100 border-l-4 border-green-500 text-green-800 px-4 py-3 rounded mb-6 shadow-sm" role="alert">
                <span class="block sm:inline font-medium text-sm">{{successMessage}}</span>
            </div>
            {{/successMessage}}

            {{#errorMessage}}
            <div class="bg-red-100 border-l-4 border-red-500 text-red-800 px-4 py-3 rounded mb-6 shadow-sm" role="alert">
                <span class="block sm:inline font-medium text-sm">{{errorMessage}}</span>
            </div>
            {{/errorMessage}}

            <form action="/login" method="post" class="space-y-6">
                
                <div>
                    <label for="username" class="block text-gray-700 text-sm font-bold mb-2">Nombre de Usuario</label>
                    <input type="text" id="username" name="username" required
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400">
                </div>
                
                <div>
                    <label for="password" class="block text-gray-700 text-sm font-bold mb-2">Contraseña</label>
                    <input type="password" id="password" name="password" required
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400">
                </div>
                
                <button type="submit"
                        class="w-full bg-uniblue text-white font-bold py-3 px-4 rounded-xl shadow-md hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-uniblue focus:ring-offset-2 focus:ring-offset-cardbg transition-all duration-200 transform hover:-translate-y-0.5 mt-2">
                    Iniciar Sesión
                </button>
                
                <div class="text-center mt-6 pt-5 border-t border-gray-400/30">
                    <p class="text-gray-600 text-sm">¿No tenés una cuenta? <br>
                        <a href="/student/create" class="text-uniblue hover:text-blue-800 font-bold transition-colors inline-block mt-1">Regístrate aquí</a>
                    </p>
                </div>
            </form>
            
        </div>
    </div>
</body>
</html>