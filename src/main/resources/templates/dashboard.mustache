<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Panel de Control - Sistema Académico</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        sidebar: '#343b4c',
                        mainbg: '#dcd8d1',
                        cardpanel: '#cecbc2',
                        cardbg: '#ebe8e1',
                        uniblue: '#3b5a82',
                        unired: '#932c35',
                        unigold: '#d7b889'
                    }
                }
            }
        }
    </script>
</head>
<body class="flex h-screen bg-mainbg font-sans overflow-hidden">

    <aside class="w-64 bg-sidebar text-gray-300 flex flex-col shadow-2xl z-10">
        <div class="p-6 pb-2 border-b border-gray-600/30">
            <h2 class="text-xl font-bold text-white tracking-wider">Sistema Académico</h2>
        </div>
        <nav class="flex-1 space-y-2 px-4 py-6 overflow-y-auto">
            </nav>
    </aside>

    <main class="flex-1 flex flex-col p-8 overflow-y-auto">
        
        {{#successMessage}}
        <div class="mb-4 p-4 bg-green-100 text-green-800 border-l-4 border-green-500 rounded-r shadow-sm">
            {{successMessage}}
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="mb-4 p-4 bg-red-100 text-red-800 border-l-4 border-red-500 rounded-r shadow-sm">
            {{errorMessage}}
        </div>
        {{/errorMessage}}

        <div class="bg-cardbg rounded-2xl shadow-sm p-8 flex justify-between items-start mb-6 border border-white/40">
            <div>
                <h1 class="text-3xl font-bold text-gray-800 tracking-tight">Panel de Control</h1>
                <p class="text-gray-600 mt-2 text-lg">
                    {{#username}}¡Bienvenido, <span class="font-bold text-uniblue">{{username}}</span>!{{/username}}
                    {{^username}}¡Bienvenido al sistema!{{/username}}
                </p>
            </div>
            
            {{^isAdmin}}
            <a href="/profile" class="flex items-center gap-2 bg-unigold text-gray-800 px-6 py-2 rounded-lg shadow-sm font-semibold hover:bg-[#cba873] transition">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                Perfil
            </a>
            {{/isAdmin}}
        </div>

        <!-- VISTA DE ESTUDIANTE -->
        {{#isStudent}}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
            <div class="bg-blue-50 border border-blue-200 p-6 rounded-lg text-center shadow-sm flex flex-col justify-between">
                <div>
                    <h2 class="text-2xl font-bold text-blue-700 mb-3">Tu Perfil</h2>
                    <p class="text-gray-600 mb-5">Gestiona tu información personal y las preferencias de tu cuenta.</p>
                </div>
                <div class="flex flex-col space-y-3">
                    <a href="/profile" class="flex items-center gap-2 bg-unigold text-gray-800 px-6 py-2 rounded-lg shadow-sm font-semibold hover:bg-[#cba873] transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        Perfil
                    </a>
                    <a href="/settings" class="inline-block bg-white text-blue-600 border border-blue-300 py-2 px-4 rounded-md hover:bg-blue-100 transition duration-300 font-semibold shadow-sm">Configuraciones</a>
                </div>
            </div>
            <div class="bg-emerald-50 border border-emerald-200 p-6 rounded-lg text-center shadow-sm flex flex-col justify-between">
                <div>
                    <h2 class="text-2xl font-bold text-emerald-700 mb-3">Opciones Académicas</h2>
                    <p class="text-gray-600 mb-5">Administra tu carrera, anotate a materias y mirá tu progreso.</p>
                </div>
                <div class="flex flex-col space-y-3">
                    <a href="/student/enroll" class="inline-block bg-emerald-600 text-white py-2 px-4 rounded-md hover:bg-emerald-700 transition duration-300 font-semibold shadow-sm">
                        Inscripción a Materias</a>
                    <a href="/student/enroll_career" class="inline-block bg-emerald-600 text-white py-2 px-4 rounded-md hover:bg-emerald-700 transition duration-300 font-semibold shadow-sm">
                        Inscripción a Carrera</a>
                    <a href="/student/plan" class="inline-block bg-white text-emerald-600 border border-emerald-300 py-2 px-4 rounded-md hover:bg-emerald-100 transition duration-300 font-semibold shadow-sm">
                        Estado de Mi Plan</a>
                </div>
            </div>
            <div class="flex flex-col gap-6">
                <div class="bg-cardpanel p-6 rounded-2xl shadow-inner border border-gray-300/50">
                    <h2 class="text-xl font-bold text-gray-800 mb-6">Administración de Sesión</h2>
                    <div class="flex flex-col items-center gap-4">
                        <a href="/logout" class="bg-unired text-white px-6 py-2 rounded-md shadow-sm font-bold hover:bg-red-800 transition w-full text-center">Cerrar Sesión</a>
                    </div>
                </div>
            </div>
        </div>
        {{/isStudent}}

        <!-- VISTA DE ADMINISTRADOR -->
        {{#isAdmin}}
        <div class="grid grid-cols-1 xl:grid-cols-3 gap-6">
            <div class="xl:col-span-2 bg-cardpanel p-6 rounded-2xl shadow-inner border border-gray-300/50">
                <h2 class="text-xl font-bold text-gray-800 mb-6">Gestión de Entidades Académicas</h2>
                <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                    <div class="bg-cardbg rounded-xl p-4 shadow text-center border border-white/50">
                        <div class="font-bold text-gray-700 mb-4 text-lg">🏛️ Facultad</div>
                        <div class="flex flex-col gap-2">
                            <a href="/faculty/create" class="bg-uniblue text-white py-2 rounded shadow-sm hover:bg-blue-800 transition font-medium">Crear</a>
                            <a href="/faculty/delete" class="bg-unired text-white py-2 rounded shadow-sm hover:bg-red-800 transition font-medium">Borrar</a>
                        </div>
                    </div>
                    <div class="bg-cardbg rounded-xl p-4 shadow text-center border border-white/50">
                        <div class="font-bold text-gray-700 mb-4 text-lg">🎓 Carrera</div>
                        <div class="flex flex-col gap-2">
                            <a href="/career/create" class="bg-uniblue text-white py-2 rounded shadow-sm hover:bg-blue-800 transition font-medium">Crear</a>
                            <a href="/career/delete" class="bg-unired text-white py-2 rounded shadow-sm hover:bg-red-800 transition font-medium">Borrar</a>
                        </div>
                    </div>
                    <div class="bg-cardbg rounded-xl p-4 shadow text-center border border-white/50">
                        <div class="font-bold text-gray-700 mb-4 text-lg">📄 Plan</div>
                        <div class="flex flex-col gap-2">
                            <a href="/program-of-study/create" class="bg-uniblue text-white py-2 rounded shadow-sm hover:bg-blue-800 transition font-medium">Crear</a>
                            <a href="/program-of-study/delete" class="bg-unired text-white py-2 rounded shadow-sm hover:bg-red-800 transition font-medium">Borrar</a>
                        </div>
                    </div>
                    <div class="bg-cardbg rounded-xl p-4 shadow text-center border border-white/50">
                        <div class="font-bold text-gray-700 mb-4 text-lg">👨‍🏫 Profesor</div>
                        <div class="flex flex-col gap-2">
                            <a href="/professor/create" class="bg-uniblue text-white py-2 rounded shadow-sm hover:bg-blue-800 transition font-medium">Crear</a>
                            <a href="/professor/delete" class="bg-unired text-white py-2 rounded shadow-sm hover:bg-red-800 transition font-medium">Borrar</a>
                        </div>
                    </div>
                    <div class="bg-cardbg rounded-xl p-4 shadow text-center border border-white/50">
                        <div class="font-bold text-gray-700 mb-4 text-lg">📚 Materia</div>
                        <div class="flex flex-col gap-2">
                            <a href="/materia/create" class="bg-uniblue text-white py-2 rounded shadow-sm hover:bg-blue-800 transition font-medium">Crear</a>
                            <a href="/materia/delete" class="bg-unired text-white py-2 rounded shadow-sm hover:bg-red-800 transition font-medium">Borrar</a>
                        </div>
                    </div>
                </div>
            </div>
            <div class="flex flex-col gap-6">
                <div class="bg-cardpanel p-6 rounded-2xl shadow-inner border border-gray-300/50">
                    <h2 class="text-xl font-bold text-gray-800 mb-6">Administración de Sesión</h2>
                    <div class="flex flex-col items-center gap-4">
                        <a href="/logout" class="bg-unired text-white px-6 py-2 rounded-md shadow-sm font-bold hover:bg-red-800 transition w-full text-center">Cerrar Sesión</a>
                        <a href="/settings/change-password" class="bg-unired text-white px-6 py-2 rounded-md shadow-sm font-bold hover:bg-red-800 transition w-full text-center">Cambiar Contraseña</a>
                    </div>
                </div>
            </div>
        </div>
        {{/isAdmin}}

        <!-- VISTA DE PROFESOR -->
        {{#isProfessor}}
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">

            <!-- Perfil -->
            <div class="bg-blue-50 border border-blue-200 p-6 rounded-lg text-center shadow-sm flex flex-col justify-between">
                <div>
                    <h2 class="text-2xl font-bold text-blue-700 mb-3">Tu Perfil</h2>
                    <p class="text-gray-600 mb-5">Gestiona tu información personal y las preferencias de tu cuenta.</p>
                </div>
                <div class="flex flex-col space-y-3">
                    <a href="/profile" class="flex items-center gap-2 bg-unigold text-gray-800 px-6 py-2 rounded-lg shadow-sm font-semibold hover:bg-[#cba873] transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                        Perfil
                    </a>
                    <a href="/settings" class="inline-block bg-white text-blue-600 border border-blue-300 py-2 px-4 rounded-md hover:bg-blue-100 transition duration-300 font-semibold shadow-sm">Configuraciones</a>
                </div>
            </div>

            <!-- Mesas de Examen -->
            <div class="bg-emerald-50 border border-emerald-200 p-6 rounded-lg text-center shadow-sm flex flex-col justify-between">
                <div>
                    <h2 class="text-2xl font-bold text-emerald-700 mb-3">Mesas de Examen</h2>
                    <p class="text-gray-600 mb-5">Creá y gestioná las mesas de examen final para tus materias.</p>
                </div>
                <div class="flex flex-col space-y-3">
                    <a href="/professor/exam-tables" class="inline-block bg-emerald-600 text-white py-2 px-4 rounded-md hover:bg-emerald-700 transition duration-300 font-semibold shadow-sm">
                        📋 Mis Mesas
                    </a>
                    <a href="/professor/exam-tables/new" class="inline-block bg-white text-emerald-600 border border-emerald-300 py-2 px-4 rounded-md hover:bg-emerald-100 transition duration-300 font-semibold shadow-sm">
                        ➕ Crear Nueva Mesa
                    </a>
                </div>
            </div>

            <!-- Cronograma -->
            <div class="bg-yellow-50 border border-yellow-200 p-6 rounded-lg text-center shadow-sm flex flex-col justify-between">
                <div>
                    <h2 class="text-2xl font-bold text-yellow-700 mb-3">Cronogramas</h2>
                    <p class="text-gray-600 mb-5">Creá y eliminá cronogramas de materias.</p>
                </div>
                <div class="flex flex-col space-y-3">
                    <a href="/schedule/create" class="inline-block bg-yellow-500 text-white py-2 px-4 rounded-md hover:bg-yellow-600 transition duration-300 font-semibold shadow-sm">
                        📅 Crear Cronograma
                    </a>
                    <a href="/schedule/delete" class="inline-block bg-white text-yellow-600 border border-yellow-300 py-2 px-4 rounded-md hover:bg-yellow-100 transition duration-300 font-semibold shadow-sm">
                        🗑️ Eliminar Cronograma
                    </a>
                </div>
            </div>

            <!-- Sesión -->
            <div class="flex flex-col gap-6">
                <div class="bg-cardpanel p-6 rounded-2xl shadow-inner border border-gray-300/50">
                    <h2 class="text-xl font-bold text-gray-800 mb-6">Administración de Sesión</h2>
                    <div class="flex flex-col items-center gap-4">
                        <a href="/logout" class="bg-unired text-white px-6 py-2 rounded-md shadow-sm font-bold hover:bg-red-800 transition w-full text-center">Cerrar Sesión</a>
                    </div>
                </div>
            </div>

        </div>
        {{/isProfessor}}

    </main>
</body>
</html>