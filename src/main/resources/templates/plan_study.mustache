<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Planes de Estudio</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-50 min-h-screen p-6">

    <div class="max-w-7xl mx-auto space-y-6">
        
        <div class="bg-white p-6 rounded-xl shadow-sm border border-gray-200">
            <h2 class="text-2xl font-light text-gray-700 mb-6 border-b pb-2">Seleccione la carrera y materias</h2>
            
            <form action="/program-of-study/view" method="GET" class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-4">
                
                <div class="flex items-center space-x-4">
                    <label class="font-semibold text-gray-700 w-1/3 text-right text-sm">Carrera</label>
                    <select name="carrera_id" onchange="this.form.submit()" class="w-2/3 border border-gray-300 rounded-md p-2 text-sm focus:ring-2 focus:ring-blue-400 focus:outline-none">
                        <option value="">Seleccione una carrera...</option>
                        {{#carreras}}
                            <option value="{{id}}" {{#selected}}selected{{/selected}}>{{name}}</option>
                        {{/carreras}}
                    </select>
                </div>

                <div class="flex items-center space-x-4">
                    <label class="font-semibold text-gray-700 w-1/3 text-right text-sm">Orientación</label>
                    <select name="orientacion" class="w-2/3 border border-gray-300 rounded-md p-2 text-sm">
                        <option value="sin_orientacion">Plan Sin Orientación</option>
                    </select>
                </div>

                <div class="flex items-center space-x-4">
                    <label class="font-semibold text-gray-700 w-1/3 text-right text-sm">Año del plan</label>
                    <select name="anio_plan" class="w-2/3 border border-gray-300 rounded-md p-2 text-sm">
                        <option value="">Seleccione un año...</option>
                        {{#anios_disponibles}}
                            <option value="{{year_version}}" {{#selected}}selected{{/selected}}>
                                {{year_version}}
                            </option>
                        {{/anios_disponibles}}
                    </select>
                </div>

                <div class="flex items-center space-x-4">
                    <label class="font-semibold text-gray-700 w-1/3 text-right text-sm">Mostrar Correlativas</label>
                    <select name="mostrar_correlativas" class="w-2/3 border border-gray-300 rounded-md p-2 text-sm">
                        <option value="no">No</option>
                        <option value="si">Sí</option>
                    </select>
                </div>

                <div class="flex items-center space-x-4">
                    <label class="font-semibold text-gray-700 w-1/3 text-right text-sm">Versión del plan</label>
                    <select name="version_plan" class="w-2/3 border border-gray-300 rounded-md p-2 text-sm">
                        <option value="0">0(Vigente)</option>
                    </select>
                </div>
            
                <div class="col-span-1 md:col-span-2 flex items-center justify-between mt-6 pt-4 border-t border-gray-200">
                    <button type="button"
                        onclick="window.location.href='/profile'"
                        class="text-gray-500 hover:text-gray-800 font-medium text-sm transition-colors flex items-center gap-2">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                        Volver
                    </button>
                    <button type="submit" name="accion" value="buscar" class="bg-[#5bc0de] hover:bg-[#46b8da] text-white font-medium py-2 px-6 rounded-md transition-colors shadow-sm active:scale-95">
                        Enviar Consulta
                    </button>
                </div>
            </form>
        </div>

        {{#planSeleccionado}}
        <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
            
            <div class="bg-gray-50 p-4 border-b border-gray-200 text-sm text-gray-800 leading-relaxed">
                <p>
                    <span class="font-bold">Facultad:</span> {{facultad_nombre}} 
                    <span class="font-bold ml-4">Carrera:</span> ({{carrera_id}}) {{carrera_nombre}} 
                    <span class="font-bold ml-4">Año de plan:</span> {{anio_plan}} 
                    <span class="font-bold ml-4">Versión:</span> {{version}} 
                    <span class="font-bold ml-4">Tipo:</span> {{tipo_plan}}
                </p>
                <p class="mt-1">
                    <span class="font-bold">Duración:</span> {{duracion}} 
                    <span class="font-bold ml-4">Estado:</span> {{estado}} 
                    <span class="font-bold ml-4">Horas totales:</span> {{horas_totales}} 
                    <span class="font-bold ml-4">Horas optativas:</span> {{horas_optativas}}
                </p>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="bg-white text-gray-700 text-sm border-b-2">
                            <th class="p-3 font-bold">Nombre</th>
                            <th class="p-3 font-bold">Período</th>
                            <th class="p-3 font-bold">Tipo</th>
                            <th class="p-3 font-bold">DispoP/Cursar</th>
                            <th class="p-3 font-bold">Horas</th>
                            <th class="p-3 font-bold">Año</th>
                            {{#mostrar_correlativas}}
                                <th class="p-3 font-bold">C/Cursar</th>
                                <th class="p-3 font-bold">C/Rendir</th>
                            {{/mostrar_correlativas}}
                        </tr>
                    </thead>
                    <tbody class="text-sm">
                        {{#materias}}
                        <tr class="border-b hover:bg-gray-50">
                            <td class="p-3 text-gray-800">[{{codigo}}] {{nombre}}</td>
                            <td class="p-3 text-gray-600">{{periodo}}</td>
                            <td class="p-3 text-gray-600">{{tipo}}</td>
                            <td class="p-3 text-gray-600">{{disponibilidad}}</td>
                            <td class="p-3 text-gray-600">{{horas}}</td>
                            <td class="p-3 text-gray-600">{{anio}}</td>

                            {{#mostrar_correlativas}}
                                <td class="p-3 text-gray-600">{{{correlativas_cursar}}}</td>
                                <td class="p-3 text-gray-600">{{{correlativas_rendir}}}</td>
                            {{/mostrar_correlativas}}

                        </tr>
                        {{/materias}}
                    </tbody>
                </table>
            </div>
        </div>
        {{/planSeleccionado}}

    </div>
</body>
</html>