<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Alumnos - Regularidades</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 min-h-screen p-8">
    <div class="max-w-4xl mx-auto">
        <h1 class="text-3xl font-bold text-gray-800 mb-6">Alumnos Cursando</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded mb-4">
            <span>{{successMessage}}</span>
        </div>
        {{/successMessage}}
        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded mb-4">
            <span>{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        {{#students}}
        <div class="bg-white rounded-lg shadow mb-3 p-5">
            <div class="flex items-center justify-between">
                <div>
                    <p class="font-semibold text-gray-800">{{studentName}} {{studentSurname}}</p>
                    <p class="text-gray-500 text-sm">DNI: {{studentDni}}</p>
                    <p class="text-sm mt-1">Estado: <span class="font-medium text-blue-600">{{status}}</span></p>
                </div>
                <div class="flex gap-2">
                    <form action="/professor/regularities/{{enrollmentId}}/regular" method="post">
                        <input type="hidden" name="subjectId" value="{{subjectId}}">
                        <button type="submit"
                                class="bg-green-600 text-white text-sm py-1 px-3 rounded hover:bg-green-700">
                            Regular
                        </button>
                    </form>
                    <form action="/professor/regularities/{{enrollmentId}}/libre" method="post">
                        <input type="hidden" name="subjectId" value="{{../subjectId}}">
                        <button type="submit"
                                class="bg-red-500 text-white text-sm py-1 px-3 rounded hover:bg-red-600">
                            Libre
                        </button>
                    </form>
                </div>
            </div>
        </div>
        {{/students}}

        {{^students}}
        <div class="bg-white rounded-lg shadow p-8 text-center text-gray-500">
            No hay alumnos cursando esta materia.
        </div>
        {{/students}}

        <div class="text-center mt-6">
            <button onclick="window.location.href='/professor/regularities'"
                    class="text-red-600 hover:underline text-sm">
                Volver a mis materias
            </button>
        </div>
    </div>
</body>
</html>
