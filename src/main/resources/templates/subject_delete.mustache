<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Borrar Materia</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">

    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-lg">
        <h2 class="text-3xl font-bold text-center text-red-700 mb-6">Eliminar Materia</h2>

        {{#successMessage}}
            <div class="mb-4 p-4 bg-green-100 text-green-800 border border-green-300 rounded">{{successMessage}}</div>
        {{/successMessage}}
        {{#errorMessage}}
            <div class="mb-4 p-4 bg-red-100 text-red-800 border border-red-300 rounded">{{errorMessage}}</div>
        {{/errorMessage}}

        <p class="text-gray-600 mb-6 text-center">Seleccioná la materia que querés dar de baja. <br> <span class="font-bold text-red-600">¡Esta acción no se puede deshacer!</span></p>

        <form action="/materia/delete" method="POST" class="space-y-6">
            
            <div>
                <label class="block text-gray-700 font-semibold mb-2">Seleccionar Materia:</label>
                <select name="subject_id" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-2 focus:ring-red-500 bg-white">
                    <option value="" disabled selected>-- Elegí una materia --</option>
                    {{#materias}}
                        <option value="{{id}}">{{name}} (Año: {{year}})</option>
                    {{/materias}}
                </select>
            </div>

            <div class="pt-4 flex justify-between">
                <a href="/dashboard" class="inline-block bg-gray-500 text-white py-2 px-6 rounded-md hover:bg-gray-600 transition">Volver</a>
                <button type="submit" class="inline-block bg-red-600 text-white py-2 px-6 rounded-md hover:bg-red-700 font-bold"
                        onclick="return confirm('¿Estás seguro de eliminar esta materia?');">Eliminar</button>
            </div>
            
        </form>
    </div>

</body>
</html>