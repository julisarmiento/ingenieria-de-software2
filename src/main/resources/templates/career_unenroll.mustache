<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Darse de Baja</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">
    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-md">
        <h1 class="text-3xl font-bold text-center text-gray-800 mb-6">Darse de Baja de la Carrera</h1>

        {{#successMessage}}
        <div class="bg-green-100 border border-green-400 text-green-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{successMessage}}</span>
        </div>
        {{/successMessage}}

        {{#errorMessage}}
        <div class="bg-red-100 border border-red-400 text-red-700 px-4 py-3 rounded relative mb-4" role="alert">
            <span class="block sm:inline">{{errorMessage}}</span>
        </div>
        {{/errorMessage}}

        <form action="/career/unenroll" method="post" class="space-y-4"
              onsubmit="return confirm('¿Estás seguro de que deseas darte de baja de esta carrera? Perderás el acceso a tus materias.')">
            
            <div>
                <label for="id" class="block text-gray-700 text-sm font-medium mb-1">Carrera actual:</label>
                <select id="id" name="identificador_carrera" required class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                    {{#career}}
                    <option value="{{id}}">{{name}}</option>
                    {{/career}}
                </select>
                
                {{^career}}
                <p class="text-sm text-red-500 mt-2">No estás inscripto en ninguna carrera.</p>
                {{/career}}
            </div>

            <button type="submit" {{^career}}disabled{{/career}} class="w-full bg-orange-500 text-white py-2 px-4 rounded-md hover:bg-orange-600 focus:outline-none focus:ring-2 focus:ring-orange-500 focus:ring-offset-2 disabled:bg-gray-400 disabled:cursor-not-allowed">
                Darme de Baja
            </button>
            
            <div class="text-center mt-4">
                <button type="button"
                        onclick="window.location.href='/settings'"
                        class="text-gray-600 hover:underline text-sm">
                    Volver a Configuración
                </button>
            </div>
        </form>
    </div>
</body>
</html>