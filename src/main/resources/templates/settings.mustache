<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Configuraciones</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-8">
    <div class="max-w-xl mx-auto bg-white p-8 rounded-lg shadow-lg mt-10">
        
        <h1 class="text-3xl font-bold text-gray-800 mb-6 border-b pb-2 text-center">Configuraciones</h1>

        <div class="flex flex-col space-y-4">
            
            <a href="/settings/change-password" class="block text-center bg-blue-600 text-white font-semibold py-3 px-4 rounded-md hover:bg-blue-700 transition duration-300">
                Cambiar Contraseña
            </a>

            {{#isStudent}}
            <form action="/career/unenroll" method="POST" onsubmit="return confirm('¿Estás seguro de darte de baja de carrera?');" class="w-full">
                <button type="submit" class="block w-full text-center bg-red-600 text-white font-semibold py-3 px-4 rounded-md hover:bg-red-700 transition duration-300">
                    Darse de baja de carrera
                </button>
            </form>    
            {{/isStudent}}

            <form action="/settings/delete-account" method="POST" onsubmit="return confirm('¿Estás seguro de eliminar tu cuenta?');" class="w-full">
                <button type="submit" class="block w-full text-center bg-red-600 text-white font-semibold py-3 px-4 rounded-md hover:bg-red-700 transition duration-300">
                    Eliminar usuario
                </button>
            </form>
        </div>
        
        <div class="mt-8 text-center border-t pt-4">
            <a href="/dashboard" class="text-blue-600 hover:underline font-bold">&larr; Volver al Panel</a>
        </div>

    </div>
</body>
</html>