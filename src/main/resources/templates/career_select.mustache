<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Selecciona tu carrera</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        /* Mantenemos únicamente el patrón de fondo de puntos radiales */
        body {
            background-color: #e2e4e6;
            background-image: radial-gradient(rgba(0, 0, 0, 0.03) 1px, transparent 0);
            background-size: 24px 24px;
        }
    </style>
</head>
<body class="flex justify-center items-center min-h-screen p-5">

    <div class="bg-white rounded-2xl shadow-[0_10px_30px_rgba(0,0,0,0.06),0_1px_3px_rgba(0,0,0,0.02)] p-10 w-full max-w-[440px] text-center transition-transform duration-200">
        
        <h2 class="text-[#1e293b] text-[26px] font-semibold mb-6 tracking-[-0.5px]">Selecciona tu carrera</h2>

        {{#successMessage}}
            <div class="bg-[#f0fdf4] text-[#166534] border border-[#bbf7d0] text-sm px-4 py-3 rounded-lg mb-6 leading-relaxed text-left">
                {{successMessage}}
            </div>
        {{/successMessage}}
        
        {{#errorMessage}}
            <div class="bg-[#fef2f2] text-[#991b1b] border border-[#fecaca] text-sm px-4 py-3 rounded-lg mb-6 leading-relaxed text-left">
                {{errorMessage}}
            </div>
        {{/errorMessage}}

        <form method="post" action="{{ruta_destino}}" class="text-left space-y-6">
            
            <div class="relative">
                <select id="id" name="career_id" class="w-full px-4 py-[14px] text-[15px] text-[#334155] bg-[#f8fafc] border border-[#cbd5e1] rounded-lg appearance-none cursor-pointer focus:outline-none focus:ring-[3px] focus:ring-[#3b6289]/15 focus:border-[#3b6289] focus:bg-white transition-all duration-200">
                    <option value="" disabled selected>Seleccione una Carrera</option>
                    {{#careers}}
                    <option value="{{id}}">
                        {{name}}
                    </option>
                    {{/careers}}
                </select>
                <div class="pointer-events-none absolute inset-y-0 right-4 flex items-center">
                    <svg class="h-4 w-4 fill-current text-[#64748b]" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20">
                        <path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/>
                    </svg>
                </div>
            </div>

            <button type="submit" class="w-full py-[14px] text-[15px] font-semibold text-white bg-[#3b6289] rounded-lg cursor-pointer transition-all duration-200 hover:bg-[#2c4a6b] active:scale-[0.98]">
                Confirmar
            </button>
            
            <div class="text-center pt-5 border-t border-gray-400/30">
                <button type="button"
                        onclick="window.location.href='/dashboard'"
                        class="text-gray-600 hover:text-gray-900 font-semibold text-sm flex items-center justify-center gap-2 w-full transition-colors">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                    Volver al inicio
                </button>
            </div>
        </form>
    </div>

</body>
</html>