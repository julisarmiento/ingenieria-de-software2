<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear una cuenta - Sistema Académico</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        mainbg: '#dcd8d1',
                        cardpanel: '#cecbc2',
                        cardbg: '#ebe8e1',
                        uniblue: '#3b5a82',
                        unired: '#932c35'
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-mainbg flex items-center justify-center min-h-screen p-4 font-sans">
    
    <div class="bg-cardpanel p-6 sm:p-8 rounded-2xl shadow-2xl w-full max-w-2xl border border-gray-300/50 my-8">
        
        <div class="bg-cardbg p-8 rounded-xl shadow-sm border border-white/50">
            
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-12 h-12 bg-white rounded-full mb-4 shadow-sm text-2xl">
                    👤
                </div>
                <h1 class="text-2xl font-extrabold text-gray-800 tracking-tight">Crear una cuenta</h1>
                <p class="text-gray-600 mt-2 text-sm">Completá tus datos para registrarte como alumno</p>
            </div>

            {{#successMessage}}
            <div class="bg-green-100 border-l-4 border-green-500 text-green-800 px-4 py-3 rounded mb-6 shadow-sm" role="alert">
                <span class="block sm:inline font-medium text-sm">{{successMessage}}</span>
            </div>
            {{/successMessage}}

            {{#errorMessage}}
            <div class="bg-red-100 border-l-4 border-red-500 text-red-800 px-4 py-3 rounded mb-6 shadow-sm" role="alert">
                <span class="block sm:inline font-medium text-sm">{{errorMessage}}</span>
            </div>
            {{/errorMessage}}

            <form action="/student/create" method="post" class="space-y-6">
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-white/40 p-4 rounded-xl border border-gray-300/50">
                    <div>
                        <label for="username" class="block text-gray-700 text-sm font-bold mb-2">Nombre de Usuario</label>
                        <input type="text" id="username" name="username" required
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400 text-sm" placeholder="Ej: jperez99">
                    </div>
                    <div>
                        <label for="password" class="block text-gray-700 text-sm font-bold mb-2">Contraseña</label>
                        <input type="password" id="password" name="password" required
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400 text-sm" placeholder="••••••••">
                    </div>
                </div>

                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                    <div>
                        <label for="name" class="block text-gray-700 text-sm font-bold mb-2">Nombre</label>
                        <input type="text" id="name" name="name" required
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400 text-sm" placeholder="Ej: Juan">
                    </div>
                    <div>
                        <label for="surname" class="block text-gray-700 text-sm font-bold mb-2">Apellido</label>
                        <input type="text" id="surname" name="surname" required
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400 text-sm" placeholder="Ej: Pérez">
                    </div>
                    
                    <div>
                        <label for="dni" class="block text-gray-700 text-sm font-bold mb-2">DNI</label>
                        <input type="text" id="dni" name="dni" required
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400 text-sm" placeholder="Ej: 12345678">
                    </div>
                    <div>
                        <label for="age" class="block text-gray-700 text-sm font-bold mb-2">Edad</label>
                        <input type="number" id="age" name="age" required min="16" max="99"
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400 text-sm" placeholder="Ej: 21">
                    </div>

                    <div>
                        <label for="mail" class="block text-gray-700 text-sm font-bold mb-2">Correo Electrónico</label>
                        <input type="email" id="mail" name="mail" required
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400 text-sm" placeholder="ejemplo@correo.com">
                    </div>
                    <div>
                        <label for="phoneNum" class="block text-gray-700 text-sm font-bold mb-2">Teléfono</label>
                        <input type="text" id="phoneNum" name="phoneNum" required
                               class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400 text-sm" placeholder="Ej: 3584123456">
                    </div>
                </div>

                <div class="pt-4">
                    <button type="submit"
                            class="w-full bg-uniblue text-white font-bold py-3 px-4 rounded-xl shadow-md hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-uniblue focus:ring-offset-2 focus:ring-offset-cardbg transition-all duration-200 transform hover:-translate-y-0.5">
                        Registrar Usuario
                    </button>
                </div>
                
                <div class="text-center mt-6 pt-5 border-t border-gray-400/30">
                    <a href="/" class="text-gray-600 hover:text-gray-900 font-semibold text-sm flex items-center justify-center gap-2 w-full transition-colors">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                        Volver al inicio
                    </a>
                </div>
            </form>
            
        </div>
    </div>
</body>
</html>