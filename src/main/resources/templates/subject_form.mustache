<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Alta de Materia Base</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 flex items-center justify-center min-h-screen p-4">

    <div class="bg-white p-8 rounded-lg shadow-lg w-full max-w-lg">
        <h2 class="text-3xl font-bold text-center text-gray-800 mb-6">Crear Materia</h2>

        {{#errorMessage}}
            <div class="mb-4 p-4 bg-red-100 text-red-800 border border-red-300 rounded">{{errorMessage}}</div>
        {{/errorMessage}}

        <form action="/materia/create" method="POST" class="space-y-6">
            
            <div>
                <label class="block text-gray-700 font-semibold mb-2">Carrera:</label>
                <select name="career_id" required 
                        class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
                        <option value="" disabled selected>Seleccione una carrera...</option>
                        {{#careers}}
                            <option value="{{id}}">{{name}}</option>
                        {{/careers}}
                </select>
            </div>

            <div>
                <label class="block text-gray-700 font-semibold mb-2">Código de la Materia:</label>
                <input type="number" name="id" placeholder="Ej: 3300" required 
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>
            
            <div>
                <label class="block text-gray-700 font-semibold mb-2">Nombre de la Materia:</label>
                <input type="text" name="name" placeholder="Ej: Análisis Matemático I" required 
                       class="w-full px-4 py-2 border border-gray-300 rounded-md focus:outline-none focus:ring-2 focus:ring-blue-500">
            </div>

            <div class="pt-4 flex justify-between">
                <a href="/dashboard" class="inline-block bg-gray-500 text-white py-2 px-6 rounded-md hover:bg-gray-600 transition">Volver</a>
                <button type="submit" class="inline-block bg-blue-600 text-white py-2 px-6 rounded-md hover:bg-blue-700 font-bold">Crear</button>
            </div>
        </form>
    </div>

</body>
</html>