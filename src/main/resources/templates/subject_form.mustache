<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Crear Materia - Sistema Académico</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        mainbg: '#dcd8d1',
                        cardpanel: '#cecbc2',
                        cardbg: '#ebe8e1',
                        uniblue: '#3b5a82',
                        unired: '#932c35'
                    }
                }
            }
        }
    </script>
</head>
<body class="bg-mainbg flex items-center justify-center min-h-screen p-4 font-sans">

    <div class="bg-cardpanel p-6 sm:p-8 rounded-2xl shadow-2xl w-full max-w-lg border border-gray-300/50">
        
        <div class="bg-cardbg p-8 rounded-xl shadow-sm border border-white/50">
            
            <div class="text-center mb-8">
                <div class="inline-flex items-center justify-center w-12 h-12 bg-white rounded-full mb-4 shadow-sm text-2xl">
                    📚
                </div>
                <h1 class="text-2xl font-extrabold text-gray-800 tracking-tight">Crear Materia</h1>
                <p class="text-gray-600 mt-2 text-sm">Registra una nueva materia base en el sistema</p>
            </div>

            {{#errorMessage}}
            <div class="bg-red-100 border-l-4 border-red-500 text-red-800 px-4 py-3 rounded mb-6 shadow-sm" role="alert">
                <span class="block sm:inline font-medium text-sm">{{errorMessage}}</span>
            </div>
            {{/errorMessage}}

            <form action="/materia/create" method="POST" class="space-y-6">
                
                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-2">Carrera</label>
                    <select name="career_id" required 
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner cursor-pointer">
                        <option value="" disabled selected>Seleccione una carrera...</option>
                        {{#careers}}
                            <option value="{{id}}">{{name}}</option>
                        {{/careers}}
                    </select>
                </div>

                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-2">Código de la Materia</label>
                    <input type="number" name="id" placeholder="Ej: 3300" required 
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400">
                </div>
                
                <div>
                    <label class="block text-gray-700 text-sm font-bold mb-2">Nombre de la Materia</label>
                    <input type="text" name="name" placeholder="Ej: Análisis Matemático I" required 
                           class="w-full px-4 py-3 border border-gray-300 rounded-xl focus:outline-none focus:ring-2 focus:ring-uniblue bg-white/90 text-gray-800 transition-all shadow-inner placeholder-gray-400">
                </div>

                <div class="pt-6 flex justify-between items-center border-t border-gray-400/30">
                    <a href="/dashboard" 
                       class="inline-block bg-gray-600 text-white py-2 px-6 rounded-xl hover:bg-gray-700 transition shadow-md font-semibold">
                        Volver
                    </a>
                    <button type="submit" 
                            class="inline-block bg-uniblue text-white py-2 px-6 rounded-xl shadow-md hover:bg-blue-800 focus:outline-none focus:ring-2 focus:ring-uniblue focus:ring-offset-2 focus:ring-offset-cardbg transition-all duration-200 font-bold transform hover:-translate-y-0.5">
                        Crear
                    </button>
                </div>
                
            </form>
        </div>
    </div>

</body>
</html>