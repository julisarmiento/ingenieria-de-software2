<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>Asignar Correlativas</title>
    <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 p-4">
    <div class="max-w-4xl mx-auto bg-white p-8 rounded-lg shadow-lg">
        <h2 class="text-2xl font-bold mb-6 text-blue-700">Configurar Correlativas</h2>
        <p class="text-gray-600 mb-4 text-sm">Definir los requisitos para cada materia correlativa:</p>

        <form action="/plan-subject/correlatives" method="POST" class="space-y-6">
            <input type="hidden" name="program_id" value="{{program_id}}">
            <input type="hidden" name="plan_subject_id" value="{{plan_subject_id}}">

            <div class="h-96 overflow-y-auto border border-gray-300 rounded shadow-inner">
                <table class="w-full text-sm text-left">
                    <thead class="bg-gray-100 sticky top-0">
                        <tr>
                            <th class="p-3">Materia</th>
                            <th class="p-3">Para Cursar</th>
                            <th class="p-3">Para Rendir Final</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#subjects}}
                        <tr class="border-b hover:bg-gray-50">
                            <td class="p-3 font-medium text-gray-700">{{name}}</td>
                            <td class="p-3">
                                <select name="cursar_{{id}}" class="border rounded p-1 text-xs">
                                    <option value="NONE">Ninguno</option>
                                    <option value="REGULAR">Regular</option>
                                    <option value="APROBADA">Aprobada</option>
                                </select>
                            </td>
                            <td class="p-3">
                                <select name="rendir_{{id}}" class="border rounded p-1 text-xs">
                                    <option value="NONE">Ninguno</option>
                                    <option value="REGULAR">Regular</option>
                                    <option value="APROBADA">Aprobada</option>
                                </select>
                            </td>
                        </tr>
                        {{/subjects}}
                    </tbody>
                </table>
            </div>

            <button type="submit" class="w-full bg-green-600 text-white py-3 rounded font-bold hover:bg-green-700">
                Guardar 
            </button>
        </form>
    </div>
</body>
</html>